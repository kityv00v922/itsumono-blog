---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrNotice from '../../components/PrNotice.astro';
import { getPublishedPosts, formatDate, categoryName, url, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, category, cover, coverAlt, draft } = post.data;
---

<BaseLayout title={title} description={description} noindex={draft}>
  <article>
    <header class="post-header">
      {draft && <p class="draft-banner">これは下書きです（本番サイトには公開されません）</p>}
      <p class="meta">
        <a href={url(`category/${category}/`)}>{categoryName(category)}</a>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span>更新 {formatDate(updatedDate)}</span>}
      </p>
      <h1>{title}</h1>
    </header>

    <!-- PR表記：全記事の冒頭に自動で入ります。削除しないでください -->
    <PrNotice />

    {
      cover && (
        <Image
          class="cover"
          src={cover}
          alt={coverAlt ?? ''}
          widths={[400, 800, 1200]}
          sizes="(max-width: 42rem) 100vw, 42rem"
          loading="eager"
          fetchpriority="high"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header h1 {
    font-size: 1.5rem;
    margin: 0.2em 0 0.8em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: 0.8125rem;
    color: var(--c-sub);
  }
  .draft-banner {
    margin: 0 0 12px;
    padding: 8px 12px;
    border: 1px dashed var(--c-sub);
    font-size: 0.875rem;
  }
  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin: 0 0 24px;
  }
</style>
